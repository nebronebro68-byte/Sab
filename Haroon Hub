    local duration = config.Duration or 3

    PlayNotificationSound() -- Play sound on notification

    local parentUI = GetUIParent()
    local Holder = parentUI:FindFirstChild("HaroonNotificationHolder")

    if not Holder then
        Holder = Instance.new("Frame")
