                    selectedStates[opt] = false
                end
                if type(default) == "table" then
                    for _, defOpt in ipairs(default) do
                        -- Ensure the default option exists in the options table
                        local found = false
                        for _, opt in ipairs(options) do
                            if opt == defOpt then
                                found = true
                                break
                            end
                        end
                        if found then
                            selectedStates[defOpt] = true
                        else
                            warn("HaroonWindUI: Default option '" .. tostring(defOpt) .. "' not found in dropdown options.")
                        end
                    end
                end
            end

            local isExpanded = false

            local DropFrame = Instance.new("Frame")
            DropFrame.Size = UDim2.new(1, 0, 0, 36)
            DropFrame.BackgroundColor3 = HaroonWindUI.Theme.Card
            DropFrame.ClipsDescendants = true
            DropFrame.Parent = Page

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = DropFrame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.5, 0, 0, 36)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.Text = dropText
            Label.Font = Enum.Font.GothamMedium
            Label.TextColor3 = HaroonWindUI.Theme.TextActive
            Label.TextSize = 12
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.BackgroundTransparency = 1
            Label.Parent = DropFrame

            local SelectedLabel = Instance.new("TextLabel")
            SelectedLabel.Size = UDim2.new(0.4, 0, 0, 36)
            SelectedLabel.Position = UDim2.new(0.55, -10, 0, 0)
            SelectedLabel.Text = currentSelectedText .. "  ▼"
            SelectedLabel.Font = Enum.Font.Gotham
            SelectedLabel.TextColor3 = HaroonWindUI.Theme.AccentRed
            SelectedLabel.TextSize = 11
            SelectedLabel.TextXAlignment = Enum.TextXAlignment.Right
            SelectedLabel.TextTruncate = Enum.TextTruncate.AtEnd
            SelectedLabel.BackgroundTransparency = 1
            SelectedLabel.Parent = DropFrame

            local OptionsContainer = Instance.new("Frame")
            OptionsContainer.Size = UDim2.new(1, -20, 0, #options * 26)
            OptionsContainer.Position = UDim2.new(0, 10, 0, 36)
            OptionsContainer.BackgroundTransparency = 1
            OptionsContainer.Parent = DropFrame

            local CList = Instance.new("UIListLayout")
            CList.SortOrder = Enum.SortOrder.LayoutOrder
            CList.Padding = UDim.new(0, 2)
            CList.Parent = OptionsContainer

            local function updateSelectedLabel()
                local selectedItems = {}
                for opt, state in pairs(selectedStates) do
                    if state then
                        table.insert(selectedItems, opt)
                    end
                end
                if #selectedItems > 0 then
                    SelectedLabel.Text = table.concat(selectedItems, ", ") .. "  ▼"
                else
                    SelectedLabel.Text = "Select items..." .. "  ▼"
                end
            end

            for _, option in ipairs(options) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.Name = "Option_" .. option:gsub("%s+", "_") -- Unique name for option button
                OptBtn.Size = UDim2.new(1, 0, 0, 24)
                OptBtn.BackgroundColor3 = selectedStates[option] and HaroonWindUI.Theme.MultiSelectSelected or HaroonWindUI.Theme.Sidebar
                OptBtn.Text = "  " .. option
                OptBtn.Font = Enum.Font.Gotham
                OptBtn.TextColor3 = selectedStates[option] and HaroonWindUI.Theme.TextActive or HaroonWindUI.Theme.SubText
                OptBtn.TextSize = 11
                OptBtn.TextXAlignment = Enum.TextXAlignment.Left
                OptBtn.AutoButtonColor = false
                OptBtn.Parent = OptionsContainer

                local OptCorner = Instance.new("UICorner")
                OptCorner.CornerRadius = UDim.new(0, 4)
                OptCorner.Parent = OptBtn

                if multiSelect then
                    local Checkmark = Instance.new("ImageLabel")
                    Checkmark.Name = "Checkmark"
                    Checkmark.Size = UDim2.fromOffset(14, 14)
                    Checkmark.Position = UDim2.new(1, -20, 0.5, -7)
                    Checkmark.Image = ICONS.Checkmark
                    Checkmark.ImageColor3 = HaroonWindUI.Theme.AccentRed
                    Checkmark.BackgroundTransparency = 1
                    Checkmark.Visible = selectedStates[option]
                    Checkmark.Parent = OptBtn
                end

                OptBtn.MouseButton1Click:Connect(function()
                    if multiSelect then
                        selectedStates[option] = not selectedStates[option]
                        FastTween(OptBtn, 0.15, {BackgroundColor3 = selectedStates[option] and HaroonWindUI.Theme.MultiSelectSelected or HaroonWindUI.Theme.Sidebar})
                        FastTween(OptBtn, 0.15, {TextColor3 = selectedStates[option] and HaroonWindUI.Theme.TextActive or HaroonWindUI.Theme.SubText})
                        if multiSelect and OptBtn:FindFirstChild("Checkmark") then OptBtn.Checkmark.Visible = selectedStates[option] end
                        updateSelectedLabel()
                        pcall(callback, selectedStates)
                    else
                        for opt, _ in pairs(selectedStates) do
                            selectedStates[opt] = false
                            local prevBtn = OptionsContainer:FindFirstChild("Option_" .. opt:gsub("%s+", "_"))
                            if prevBtn then
                                FastTween(prevBtn, 0.15, {BackgroundColor3 = HaroonWindUI.Theme.Sidebar})
                                FastTween(prevBtn, 0.15, {TextColor3 = HaroonWindUI.Theme.SubText})
                            end
                        end
                        selectedStates[option] = true
                        FastTween(OptBtn, 0.15, {BackgroundColor3 = HaroonWindUI.Theme.MultiSelectSelected})
                        FastTween(OptBtn, 0.15, {TextColor3 = HaroonWindUI.Theme.TextActive})
                        SelectedLabel.Text = option .. "  ▼"
                        isExpanded = false
                        FastTween(DropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 36)})
                        pcall(callback, option)
                    end
                end)
            end

            local ToggleBtn = Instance.new("TextButton")
            ToggleBtn.Size = UDim2.new(1, 0, 0, 36)
            ToggleBtn.BackgroundTransparency = 1
            ToggleBtn.Text = ""
            ToggleBtn.Parent = DropFrame

            ToggleBtn.MouseButton1Click:Connect(function()
                isExpanded = not isExpanded
                local targetHeight = isExpanded and (38 + (#options * 26)) or 36
                FastTween(DropFrame, 0.25, {Size = UDim2.new(1, 0, 0, targetHeight)})
            end)

            updateSelectedLabel() -- Initial update
        end

        return TabObj
    end

    return WindowObj
end

-- Notification Toast System
function HaroonWindUI:Notify(config)
    config = config or {}
    local title = config.Title or "Notification"
    local content = config.Content or ""
    local duration = config.Duration or 3

    local parentUI = GetUIParent()
    local Holder = parentUI:FindFirstChild("HaroonNotificationHolder")

    if not Holder then
        Holder = Instance.new("Frame")
        Holder.Name = "HaroonNotificationHolder"
        Holder.Size = UDim2.new(0, 240, 1, 0)
        Holder.Position = UDim2.new(1, -250, 0, 15)
        Holder.BackgroundTransparency = 1
        Holder.Parent = parentUI

        local Layout = Instance.new("UIListLayout")
        Layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        Layout.Padding = UDim.new(0, 6)
        Layout.Parent = Holder
    end

    local Toast = Instance.new("Frame")
    Toast.Size = UDim2.new(1, 0, 0, 65) -- Increased height for time bar
    Toast.BackgroundColor3 = HaroonWindUI.Theme.Card
    Toast.Position = UDim2.new(0, -Toast.Size.X.Offset, 0, 0) -- Start off-screen left
    Toast.Parent = Holder

    local ToastCorner = Instance.new("UICorner")
    ToastCorner.CornerRadius = UDim.new(0, 6)
    ToastCorner.Parent = Toast

    local ToastStroke = Instance.new("UIStroke")
    ToastStroke.Color = HaroonWindUI.Theme.AccentRed
    ToastStroke.Thickness = 1
    ToastStroke.Parent = Toast

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, -20, 0, 18)
    TitleLabel.Position = UDim2.new(0, 8, 0, 5)
    TitleLabel.Text = title
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextColor3 = HaroonWindUI.Theme.TextActive
    TitleLabel.TextSize = 12
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Parent = Toast

    local ContentLabel = Instance.new("TextLabel")
    ContentLabel.Size = UDim2.new(1, -20, 0, 20)
    ContentLabel.Position = UDim2.new(0, 8, 0, 23)
    ContentLabel.Text = content
    ContentLabel.Font = Enum.Font.Gotham
    ContentLabel.TextColor3 = HaroonWindUI.Theme.SubText
    ContentLabel.TextSize = 10
    ContentLabel.TextXAlignment = Enum.TextXAlignment.Left
    ContentLabel.BackgroundTransparency = 1
    ContentLabel.Parent = Toast

    -- Close Button for Notification
    local CloseBtn = Instance.new("ImageButton")
    CloseBtn.Size = UDim2.fromOffset(16, 16)
    CloseBtn.Position = UDim2.new(1, -24, 0, 8)
    CloseBtn.Image = ICONS.Close
    CloseBtn.ImageColor3 = HaroonWindUI.Theme.NotificationClose
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Parent = Toast

    CloseBtn.MouseButton1Click:Connect(function()
        FastTween(Toast, 0.3, {Position = UDim2.new(0, -Toast.Size.X.Offset, 0, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            .Completed:Connect(function()
                Toast:Destroy()
            end)
    end)

    -- Time Bar
    local TimeBar = Instance.new("Frame")
    TimeBar.Size = UDim2.new(1, -16, 0, 4)
    TimeBar.Position = UDim2.new(0, 8, 1, -10)
    TimeBar.BackgroundColor3 = HaroonWindUI.Theme.ToggleOff
    TimeBar.Parent = Toast

    local TimeBarCorner = Instance.new("UICorner")
    TimeBarCorner.CornerRadius = UDim.new(1, 0)
    TimeBarCorner.Parent = TimeBar

    local TimeFill = Instance.new("Frame")
    TimeFill.Size = UDim2.new(1, 0, 1, 0)
    TimeFill.BackgroundColor3 = HaroonWindUI.Theme.AccentRed
    TimeFill.Parent = TimeBar

    local TimeFillCorner = Instance.new("UICorner")
    TimeFillCorner.CornerRadius = UDim.new(1, 0)
    TimeFillCorner.Parent = TimeFill

    local TimeText = Instance.new("TextLabel")
    TimeText.Size = UDim2.new(1, 0, 1, 0)
    TimeText.Text = tostring(duration) .. "s"
    TimeText.Font = Enum.Font.Gotham
    TimeText.TextColor3 = HaroonWindUI.Theme.TextActive
    TimeText.TextSize = 8
    TimeText.BackgroundTransparency = 1
    TimeText.Parent = TimeBar

    -- Appear animation (from left to right)
    FastTween(Toast, 0.3, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    -- Countdown logic
    task.spawn(function()
        local remainingTime = duration
        while remainingTime > 0 and Toast.Parent do
            TimeText.Text = tostring(math.ceil(remainingTime)) .. "s"
            FastTween(TimeFill, 0.1, {Size = UDim2.new(remainingTime / duration, 0, 1, 0)})
            remainingTime = remainingTime - 0.1
            task.wait(0.1)
        end
        if Toast.Parent then
            -- Disappear animation (to left)
            FastTween(Toast, 0.3, {Position = UDim2.new(0, -Toast.Size.X.Offset, 0, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                .Completed:Connect(function()
                    Toast:Destroy()
                end)
        end
    end)
end

