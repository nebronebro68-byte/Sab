            SliderBar.BackgroundColor3 = HaroonWindUI.Theme.ToggleOff
            SliderBar.Parent = SliderFrame

            local SliderBarCorner = Instance.new("UICorner")
            SliderBarCorner.CornerRadius = UDim.new(1, 0)
            SliderBarCorner.Parent = SliderBar

            local Fill = Instance.new("Frame")
            local startPercent = (default - min) / (max - min)
            Fill.Size = UDim2.new(startPercent, 0, 1, 0)
            Fill.BackgroundColor3 = HaroonWindUI.Theme.AccentRed
            Fill.Parent = SliderBar

            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(1, 0)
            FillCorner.Parent = Fill

            local isDragging = false

            local function UpdateSlider(input)
                local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
                local value = math.floor(min + ((max - min) * pos))
                ValueLabel.Text = tostring(value)
                FastTween(Fill, 0.05, {Size = UDim2.new(pos, 0, 1, 0)})
                pcall(callback, value)
            end

            SliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = true
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input)
                end
            end)
        end

        -- 6. DROPDOWN (MultiSelect Support)
        function TabObj:CreateDropdown(dropText, options, default, callback, multiSelect)
            options = options or {}
            callback = callback or function() end
            multiSelect = multiSelect or false

            local selectedStates = {} -- {[option: string]: boolean}
            local currentSelectedText = "Select items..."

            if not multiSelect then
                local singleSelected = default or options[1] or "Select..."
                selectedStates[singleSelected] = true
                currentSelectedText = singleSelected
            else
                for _, opt in ipairs(options) do
                    selectedStates[opt] = false
                end
                if type(default) == "table" then
                    for _, defOpt in ipairs(default) do
                        -- Ensure the default option exists in the options table
                        local found = false
                        for _, opt in ipairs(options) do
                            if opt == defOpt then
                                found = true
                                break
                            end
                        end
                        if found then
                            selectedStates[defOpt] = true
                        else
                            warn("HaroonWindUI: Default option '" .. tostring(defOpt) .. "' not found in dropdown options.")
                        end
                    end
                end
            end

            local isExpanded = false

            local DropFrame = Instance.new("Frame")
            DropFrame.Size = UDim2.new(1, 0, 0, 36)
            DropFrame.BackgroundColor3 = HaroonWindUI.Theme.Card
            DropFrame.ClipsDescendants = true
            DropFrame.Parent = Page

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = DropFrame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.5, 0, 0, 36)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.Text = dropText
            Label.Font = Enum.Font.GothamMedium
            Label.TextColor3 = HaroonWindUI.Theme.TextActive
            Label.TextSize = 12
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.BackgroundTransparency = 1
            Label.Parent = DropFrame

            local SelectedLabel = Instance.new("TextLabel")
            SelectedLabel.Size = UDim2.new(0.4, 0, 0, 36)
            SelectedLabel.Position = UDim2.new(0.55, -10, 0, 0)
            SelectedLabel.Text = currentSelectedText .. "  ▼"
            SelectedLabel.Font = Enum.Font.Gotham
            SelectedLabel.TextColor3 = HaroonWindUI.Theme.AccentRed
            SelectedLabel.TextSize = 11
            SelectedLabel.TextXAlignment = Enum.TextXAlignment.Right
            SelectedLabel.TextTruncate = Enum.TextTruncate.AtEnd
            SelectedLabel.BackgroundTransparency = 1
            SelectedLabel.Parent = DropFrame

            local OptionsContainer = Instance.new("Frame")
            OptionsContainer.Size = UDim2.new(1, -20, 0, #options * 26)
            OptionsContainer.Position = UDim2.new(0, 10, 0, 36)
            OptionsContainer.BackgroundTransparency = 1
            OptionsContainer.Parent = DropFrame

            local CList = Instance.new("UIListLayout")
            CList.SortOrder = Enum.SortOrder.LayoutOrder
            CList.Padding = UDim.new(0, 2)
            CList.Parent = OptionsContainer

            local function updateSelectedLabel()
                local selectedItems = {}
                for opt, state in pairs(selectedStates) do
                    if state then
                        table.insert(selectedItems, opt)
                    end
                end
                if #selectedItems > 0 then
                    SelectedLabel.Text = table.concat(selectedItems, ", ") .. "  ▼"
                else
                    SelectedLabel.Text = "Select items..." .. "  ▼"
                end
            end

            for _, option in ipairs(options) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.Name = "Option_" .. option:gsub("%s+", "_") -- Unique name for option button
                OptBtn.Size = UDim2.new(1, 0, 0, 24)
                OptBtn.BackgroundColor3 = selectedStates[option] and HaroonWindUI.Theme.MultiSelectSelected or HaroonWindUI.Theme.Sidebar
                OptBtn.Text = "  " .. option
                OptBtn.Font = Enum.Font.Gotham
                OptBtn.TextColor3 = selectedStates[option] and HaroonWindUI.Theme.TextActive or HaroonWindUI.Theme.SubText
                OptBtn.TextSize = 11
                OptBtn.TextXAlignment = Enum.TextXAlignment.Left
                OptBtn.AutoButtonColor = false
                OptBtn.Parent = OptionsContainer

                local OptCorner = Instance.new("UICorner")
                OptCorner.CornerRadius = UDim.new(0, 4)
                OptCorner.Parent = OptBtn

                if multiSelect then
                    local Checkmark = Instance.new("ImageLabel")
                    Checkmark.Name = "Checkmark"
                    Checkmark.Size = UDim2.fromOffset(14, 14)
                    Checkmark.Position = UDim2.new(1, -20, 0.5, -7)
                    Checkmark.Image = ICONS.Checkmark
                    Checkmark.ImageColor3 = HaroonWindUI.Theme.AccentRed
                    Checkmark.BackgroundTransparency = 1
                    Checkmark.Visible = selectedStates[option]
                    Checkmark.Parent = OptBtn
                end

                OptBtn.MouseButton1Click:Connect(function()
                    if multiSelect then
                        selectedStates[option] = not selectedStates[option]
                        FastTween(OptBtn, 0.15, {BackgroundColor3 = selectedStates[option] and HaroonWindUI.Theme.MultiSelectSelected or HaroonWindUI.Theme.Sidebar})
                        FastTween(OptBtn, 0.15, {TextColor3 = selectedStates[option] and HaroonWindUI.Theme.TextActive or HaroonWindUI.Theme.SubText})
                        if multiSelect and OptBtn:FindFirstChild("Checkmark") then OptBtn.Checkmark.Visible = selectedStates[option] end
                        updateSelectedLabel()
                        pcall(callback, selectedStates)
                    else
                        for opt, _ in pairs(selectedStates) do
                            selectedStates[opt] = false
                            local prevBtn = OptionsContainer:FindFirstChild("Option_" .. opt:gsub("%s+", "_"))
                            if prevBtn then
                                FastTween(prevBtn, 0.15, {BackgroundColor3 = HaroonWindUI.Theme.Sidebar})
                                FastTween(prevBtn, 0.15, {TextColor3 = HaroonWindUI.Theme.SubText})
                            end
                        end
                        selectedStates[option] = true
                        FastTween(OptBtn, 0.15, {BackgroundColor3 = HaroonWindUI.Theme.MultiSelectSelected})
                        FastTween(OptBtn, 0.15, {TextColor3 = HaroonWindUI.Theme.TextActive})
                        SelectedLabel.Text = option .. "  ▼"
                        isExpanded = false
                        FastTween(DropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 36)})
                        pcall(callback, option)
                    end
                end)
            end

            local ToggleBtn = Instance.new("TextButton")
            ToggleBtn.Size = UDim2.new(1, 0, 0, 36)
            ToggleBtn.BackgroundTransparency = 1
            ToggleBtn.Text = ""
            ToggleBtn.Parent = DropFrame

            ToggleBtn.MouseButton1Click:Connect(function()
                isExpanded = not isExpanded
                local targetHeight = isExpanded and (38 + (#options * 26)) or 36
                FastTween(DropFrame, 0.25, {Size = UDim2.new(1, 0, 0, targetHeight)})
            end)

            updateSelectedLabel() -- Initial update
        end

        return TabObj
    end

    return WindowObj
end

